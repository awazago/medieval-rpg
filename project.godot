; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be also edited, and the config will be preserved.

config_version=5

[application]

config/name="Project Chronicles: Aethelgard"
config/description="3D Medieval MMORPG with Hybrid 1st/3rd Person Camera, Lineage II-inspired mechanics and authoritative client-server architecture."
run/main_scene="res://client/scenes/character_select.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://shared/game_data.gd"
NetworkManager="*res://shared/network_manager.gd"
AudioManager="*res://shared/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
